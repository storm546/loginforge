# loginforge runtime env — chmod 600, never commit.
OPENROUTER_API_KEY=
# Optional: pin a model instead of auto-picking a free tool-calling model.
# OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2captcha — used for every captcha after the first human login.
TWOCAPTCHA_API_KEY=

# Fixture-only credentials (local E2E target).
SITE_EMAIL=fixture@example.com
SITE_PASSWORD=fixture-pass

# Tuning
FORGE_MAX_STEPS=40
FORGE_HANDOFF_TIMEOUT=1200

# Facebook target credentials (targets/facebook.yaml)
FB_EMAIL=
FB_PASSWORD=
